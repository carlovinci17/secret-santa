{
  "rewrites": [
    { "source": "/", "destination": "/admin.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/s/:token", "destination": "/reveal.html" }
  ],
  "headers": [
    {
      "source": "/s/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
